#!/bin/bash

python3 -m venv .venv
source .venv/bin/activate
python -m pip install bibtexparser==1.4.3

python scripts/build_publications.py

# Lancer Hugo server en arrière-plan avec -D
hugo server -D &
HUGO_PID=$!

# Attendre 2 secondes que le serveur démarre
sleep 2

# Ouvrir Firefox sur l'URL locale par défaut d'Hugo
open -a "Firefox" http://localhost:1313/

# Garder le script actif et stopper Hugo proprement si on fait Ctrl+C
trap "kill $HUGO_PID" EXIT
wait $HUGO_PID
